# Скопируйте этот файл в .env и подставьте свои значения. Файл .env в git не попадает.

# --- Pinecone ---
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=interesting-facts
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=facts

# --- Embedding API (через Proxy API, OpenAI-совместимый) ---
EMBEDDING_API_KEY=your-proxy-api-key
# Базовый URL прокси, например https://your-proxy.example/v1 (для прямого OpenAI: https://api.openai.com/v1)
EMBEDDING_BASE_URL=https://your-proxy.example/v1
EMBEDDING_MODEL=text-embedding-3-small
# Размерность вектора: 1536 для text-embedding-3-small, 3072 для text-embedding-3-large
EMBEDDING_DIMENSION=1536

# --- Модель для диалога ---
CHAT_MODEL=gpt-4o-mini
# Для рассуждающих моделей (например gpt-5/gpt-6) поставьте none, иначе вызов инструментов вернёт ошибку 400.
# Для обычных моделей (gpt-4o-mini) оставьте пустым.
CHAT_REASONING_EFFORT=
# Namespace для памяти о пользователях (факты лежат в PINECONE_NAMESPACE)
PINECONE_MEMORY_NAMESPACE=memory

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# --- Поиск ---
SEARCH_TOP_K=3
